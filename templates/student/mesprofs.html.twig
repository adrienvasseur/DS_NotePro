{% extends 'base.html.twig' %}

{% block title %}Mes profs{% endblock %}

{% block body %}
    <h1>My profs</h1>

    <table class="table">
        <thead>
        <tr>
            <th scope="col">Prof</th>
        </tr>
        </thead>
        <tbody>
        {% for prof in profs %}
            <tr>
                <td>{{ prof.name }}</td>
            </tr>
        {% else %}
            <tr><td>Aucun professeur pour votre classe.</td></tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_student_notes', {id: student.id}) }}">back to grades</a>
{% endblock %}
