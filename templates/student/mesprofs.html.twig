{% extends 'base.html.twig' %}

{% block title %}Mes profs{% endblock %}

{% block body %}
    <h1>My profs</h1>

    <table class="table">
        <thead>
        <tr>
            <th scope="col">Prof</th>
        </thead>
        <tbody>
        {% for gr in professor.name %}
            <tr>
                <td>{{ gr.name }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_student_notes') }}">back to grades</a>

    {{ include('student/mygrades.html.twig') }}
{% endblock %}
